{
    "name": "MediaVault-AIRiser2026",
    "image": "mcr.microsoft.com/devcontainers/typescript-node:22",
    "postCreateCommand": "sudo apt-get update && sudo apt-get install -y ffmpeg && npm install",
    "containerEnv": {
        "AUTH_DISABLED": "true",
        "HOST": "127.0.0.1"
    },
    "forwardPorts": [
        3000
    ],
    "portsAttributes": {
        "3000": {
            "label": "MediaVault Server",
            "onAutoForward": "openPreview"
        }
    }
}
