# ── Access control ────────────────────────────────────────────────────────────
# The only Google account allowed to sign in.
ALLOWED_EMAIL=you@gmail.com
# The Tailscale account allowed through `tailscale serve` (usually the same address).
ALLOWED_TAILSCALE_LOGIN=you@gmail.com
# Firebase project used to verify Google ID tokens (no service-account key needed).
FIREBASE_PROJECT_ID=mediavault-2b811

# ── Sessions ──────────────────────────────────────────────────────────────────
# 64 hex characters. Leave empty to have the server generate .ai_runtime/session.key.
SESSION_SECRET=
SESSION_DAYS=30
# Increase to sign out every device at once.
SESSION_VERSION=1

# ── Network ───────────────────────────────────────────────────────────────────
# Listen on localhost only; remote access goes through `tailscale serve`.
HOST=127.0.0.1
PORT=3000

# Demo mode without sign-in. Refused unless HOST is 127.0.0.1 / localhost.
AUTH_DISABLED=false

# ── Optional ──────────────────────────────────────────────────────────────────
# Where media_uploads/, the JSON indexes and logs/ live (defaults to the project folder).
# DATA_DIR=
# Set to false to start the local AI only on the first upload.
# AI_AUTOSTART=true
